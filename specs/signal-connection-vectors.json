{
  "$schema": "./signal-connection-vectors.schema.json",
  "description": "Conformance test vectors for the SignalConnection lifecycle transition table. Events are phase-neutral: the same event means different things depending on the status it arrives in, which is what these vectors pin. Each vector gives a status, an event, and the expected next status (or null for rejected).",
  "vectors": [
    {
      "name": "connect_from_new",
      "status": "new",
      "event": "connect",
      "next": "connecting"
    },
    {
      "name": "connect_rejected_when_connected",
      "status": "connected",
      "event": "connect",
      "next": null
    },
    {
      "name": "established_from_connecting",
      "status": "connecting",
      "event": "established",
      "next": "connected"
    },
    {
      "name": "attempt_failed_from_connecting",
      "status": "connecting",
      "event": "attempt_failed",
      "next": "closed"
    },
    {
      "name": "attempt_timed_out_from_connecting",
      "status": "connecting",
      "event": "attempt_timed_out",
      "next": "closed"
    },
    {
      "name": "attempt_timed_out_rejected_when_connected",
      "status": "connected",
      "event": "attempt_timed_out",
      "next": null
    },
    {
      "name": "attempt_timed_out_from_reconnecting",
      "status": "reconnecting",
      "event": "attempt_timed_out",
      "next": "suspended"
    },
    {
      "name": "close_aborts_connecting",
      "status": "connecting",
      "event": "close",
      "next": "closed"
    },
    {
      "name": "transport_closed_from_connecting",
      "status": "connecting",
      "event": "transport_closed",
      "next": "closed"
    },
    {
      "name": "transport_closed_from_connected",
      "status": "connected",
      "event": "transport_closed",
      "next": "suspended"
    },
    {
      "name": "transport_closed_rejected_when_reconnecting",
      "status": "reconnecting",
      "event": "transport_closed",
      "next": null
    },
    {
      "name": "ping_timeout_from_connected",
      "status": "connected",
      "event": "ping_timeout",
      "next": "suspended"
    },
    {
      "name": "ping_timeout_rejected_when_reconnecting",
      "status": "reconnecting",
      "event": "ping_timeout",
      "next": null
    },
    {
      "name": "start_reconnect_from_connected",
      "status": "connected",
      "event": "start_reconnect",
      "next": "reconnecting"
    },
    {
      "name": "start_reconnect_from_suspended",
      "status": "suspended",
      "event": "start_reconnect",
      "next": "reconnecting"
    },
    {
      "name": "start_reconnect_rejected_when_new",
      "status": "new",
      "event": "start_reconnect",
      "next": null
    },
    {
      "name": "established_from_reconnecting",
      "status": "reconnecting",
      "event": "established",
      "next": "connected"
    },
    {
      "name": "attempt_failed_from_reconnecting",
      "status": "reconnecting",
      "event": "attempt_failed",
      "next": "suspended"
    },
    {
      "name": "leave_received_during_reconnect",
      "status": "reconnecting",
      "event": "leave_received_during_reconnect",
      "next": "closed"
    },
    {
      "name": "close_aborts_reconnecting",
      "status": "reconnecting",
      "event": "close",
      "next": "closed"
    },
    {
      "name": "close_from_connected",
      "status": "connected",
      "event": "close",
      "next": "disconnecting"
    },
    {
      "name": "close_from_suspended",
      "status": "suspended",
      "event": "close",
      "next": "closed"
    },
    {
      "name": "close_rejected_when_new",
      "status": "new",
      "event": "close",
      "next": null
    },
    {
      "name": "close_completed",
      "status": "disconnecting",
      "event": "close_completed",
      "next": "closed"
    },
    {
      "name": "transport_dropped_while_disconnecting",
      "status": "disconnecting",
      "event": "transport_closed",
      "next": "closed"
    },
    {
      "name": "closed_is_terminal_connect",
      "status": "closed",
      "event": "connect",
      "next": null
    },
    {
      "name": "closed_is_terminal_close",
      "status": "closed",
      "event": "close",
      "next": null
    }
  ]
}
